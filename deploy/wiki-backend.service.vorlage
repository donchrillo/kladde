# Vorlage für den systemd-Dienst. tools/installieren.sh ersetzt @BENUTZER@, @WURZEL@ und @PORT@
# und legt das Ergebnis als /etc/systemd/system/<ordnername>-backend.service ab.
[Unit]
Description=Wiki-Backend (FastAPI/uvicorn, liefert auch das gebaute Frontend aus)
After=network.target

[Service]
Type=simple
User=@BENUTZER@
WorkingDirectory=@WURZEL@/backend
Environment=PYTHONPATH=@WURZEL@/backend
ExecStart=@WURZEL@/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port @PORT@
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
