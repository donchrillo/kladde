# Diese Datei nach .env kopieren und ausfüllen. .env wird NICHT committet.

# Datenbank.
# Default: lokale SQLite-Datei (zero-config).
DATABASE_URL=sqlite:///./backend/app.db
# PostgreSQL stattdessen (Treiber psycopg[binary] installieren):
# Achtung: die Volltextsuche nutzt SQLite-FTS5. Unter PostgreSQL greift
# automatisch eine einfachere LIKE-Suche.
# DATABASE_URL=postgresql+psycopg://user:passwort@127.0.0.1:5432/kladde

# Frontend-Origin (für CORS und Redirects). Im Prod der Caddy-Host.
FRONTEND_URL=https://pn40.local

# Anmeldung. Solange false, arbeitet das Wiki offen im LAN — die
# Berechtigungsprüfung läuft trotzdem durch (siehe backend/src/auth.py).
# true ist erst ab Phase 2d sinnvoll; vorher antwortet die API bewusst mit 501,
# damit niemand glaubt, das Wiki sei bereits geschützt.
AUTH_ENABLED=false

# Gültigkeit einer Sitzung in Tagen. Rollierend: jede Anfrage verlängert die
# Frist, ausgeloggt wird also nur, wer 30 Tage lang nicht da war.
SESSION_DAYS=30

# Sitzungs-Cookie nur über HTTPS senden. Hinter Caddy (tls internal) true.
# Für die Entwicklung über http://localhost auf false setzen, sonst schickt der
# Browser das Cookie nicht mit und die Anmeldung scheint wirkungslos.
COOKIE_SECURE=true

# Ablage der Anhänge. Ohne Angabe: backend/attachments (in .gitignore).
# ATTACHMENT_DIR=/home/<benutzer>/kladde/backend/attachments

# Obergrenze je hochgeladener Datei in Megabyte.
MAX_UPLOAD_MB=25
